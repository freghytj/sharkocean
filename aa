local function doAutoExit()
    if not FarmState.AutoExit then return false end
    if FarmState.EscapedThisRound then return false end
    if not HRP then return false end
    if not isLocalPlayerInRound() then return false end

    notify("Auto Exit", "CD 3s antes da porta...", "computer")
    task.wait(3)

    if FarmState.EscapedThisRound then return false end
    if not isLocalPlayerInRound() then return false end
    if not FarmState.AutoFarmComputers and not FarmState.AutoExit then return false end

    local triedDoors = {}
    local maxDoorSwitches = 4
    local switches = 0
    local elevateY = 18
    local safeDist = tonumber(FarmState.BeastSafeDistance) or 40

    local function elevateAtExit(basePos)
        if not HRP or not HRP.Parent or not basePos then return end
        local bpos = getBeastPosition()
        local away = Vector3.new(1, 0, 0)
        if bpos then
            local d = Vector3.new(basePos.X - bpos.X, 0, basePos.Z - bpos.Z)
            if d.Magnitude > 0.15 then away = d.Unit end
        end
        local side = Vector3.new(-away.Z, 0, away.X)
        local phase = math.floor(os.clock() * 8) % 4
        local sideSign = (phase < 2) and 1 or -1
        local target = basePos + away * 6 + side * (5 * sideSign) + Vector3.new(0, elevateY, 0)
        HRP.CFrame = CFrame.new(target)
        HRP.AssemblyLinearVelocity = Vector3.zero
        HRP.AssemblyAngularVelocity = Vector3.zero
    end

    while switches <= maxDoorSwitches and scriptRunning and not FarmState.EscapedThisRound do
        local door, isOpen = pickBestExitDoor(triedDoors)
        if not door then
            notify("Auto Exit", "Nenhuma ExitDoor encontrada", "error")
            return false
        end
        triedDoors[door] = true

        local area = getExitArea(door)
        local trigger = getExitTrigger(door)
        local doorPivot = door:GetPivot().Position
        local bpos = getBeastPosition()
        if bpos and (doorPivot - bpos).Magnitude <= safeDist and switches < maxDoorSwitches then
            notify("Auto Exit", "Fera perto dessa porta. Trocando...", "computer")
            switches = switches + 1
            task.wait(0.2)
            continue
        end

        if isOpen or not trigger then
            notify("Auto Exit", "Porta aberta! Indo...", "success")
            local pos
            if area then
                pos = area:IsA("BasePart") and (area.Position + Vector3.new(0, 3, 0)) or area:GetPivot().Position + Vector3.new(0, 3, 0)
            else
                pos = doorPivot + Vector3.new(0, 3, 0)
            end
            local t0 = os.clock()
            while os.clock() - t0 < 2.5 and scriptRunning do
                bpos = getBeastPosition()
                if bpos and (doorPivot - bpos).Magnitude <= safeDist then
                    elevateAtExit(doorPivot)
                    task.wait(0.1)
                else
                    teleportToExit(pos)
                    break
                end
            end
            teleportToExit(pos)
            FarmState.EscapedThisRound = true
            maybeServerHopAfterRound()
            return true
        end

        notify("Auto Exit", "Abrindo porta...", "computer")
        local tpos = trigger:IsA("BasePart") and (trigger.Position + Vector3.new(0, 3, 0)) or trigger:GetPivot().Position + Vector3.new(0, 3, 0)
        teleportToExit(tpos)
        task.wait(0.25)

        local openTimeout = os.clock() + 16
        local beastNearSince = nil
        local switched = false

        while scriptRunning and not FarmState.EscapedThisRound and os.clock() < openTimeout do
            if isDoorOpen(door) or not door:FindFirstChild("ExitDoorTrigger", true) then
                notify("Auto Exit", "Porta abriu!", "success")
                break
            end
            local base = trigger:IsA("BasePart") and trigger.Position or doorPivot
            bpos = getBeastPosition()
            local beastNear = bpos and (base - bpos).Magnitude <= safeDist
            if beastNear then
                if not beastNearSince then beastNearSince = os.clock() end
                elevateAtExit(base)
                if (os.clock() - beastNearSince) >= 6 and switches < maxDoorSwitches then
                    notify("Auto Exit", "Fera 6s no range. Outra porta...", "computer")
                    switches = switches + 1
                    switched = true
                    break
                end
            else
                beastNearSince = nil
                if HRP and (HRP.Position - base).Magnitude > 8 then
                    teleportToExit(base + Vector3.new(0, 3, 0))
                end
                interactExitTrigger(trigger)
            end
            task.wait(0.15)
        end

        if switched then
            task.wait(0.2)
            continue
        end
        if FarmState.EscapedThisRound then return true end

        task.wait(0.3)
        area = getExitArea(door)
        if area then
            notify("Auto Exit", "Indo para a saida...", "success")
            local pos = area:IsA("BasePart") and (area.Position + Vector3.new(0, 3, 0)) or area:GetPivot().Position + Vector3.new(0, 3, 0)
            bpos = getBeastPosition()
            if bpos and (doorPivot - bpos).Magnitude <= safeDist and switches < maxDoorSwitches then
                notify("Auto Exit", "Fera na saida. Trocando porta...", "computer")
                switches = switches + 1
                continue
            end
            teleportToExit(pos)
        end
        FarmState.EscapedThisRound = true
        maybeServerHopAfterRound()
        return true
    end
    notify("Auto Exit", "Nao conseguiu sair com seguranca", "error")
    return false
end

local function shouldStopForRequiredPCs()
    -- se nao faz bonus e ComputersLeft == 0, ja deu pra fugir
    if FarmState.DoBonusPCs then return false end
    if ComputersLeft and typeof(ComputersLeft.Value) == "number" then
        return ComputersLeft.Value <= 0
    end
    return false
end

local function doAutoFarmLoop()
    if FarmState.AutoFarmBusy then return end
    FarmState.AutoFarmBusy = true

    task.spawn(function()
        local lastTriedKey = nil

        while FarmState.AutoFarmComputers and scriptRunning do
            local imInRound = isLocalPlayerInRound()
            if not IsGameActive.Value or FarmState.EscapedThisRound or not imInRound then
                if FarmState.EscapedThisRound then
                    -- ja fugiu: nao volta pra exit; espera jogo acabar / novo mapa
                    while FarmState.AutoFarmComputers and scriptRunning and (IsGameActive.Value or FarmState.EscapedThisRound) do
                        if not IsGameActive.Value and statusIsLobbyOrTransition() then
                            break
                        end
                        if not IsGameActive.Value then
                            break
                        end
                        task.wait(0.6)
                    end
                    -- limpa estado pra proxima rodada / mapa
                    FarmState.EscapedThisRound = false
                    for k in pairs(finishedComputerKeys) do
                        finishedComputerKeys[k] = nil
                    end
                    lastTriedKey = nil
                    FarmState.lastComputerTP = 0
                    while FarmState.AutoFarmComputers and scriptRunning and not IsGameActive.Value do
                        task.wait(0.5)
                    end
                    task.wait(0.8)
                    continue
                end
                task.wait(1)
                continue
            end

            -- PCs obrigatorios ja feitos e sem bonus -> exit (mantem autofarm ligado pro proximo mapa)
            if shouldStopForRequiredPCs() then
                notify("Autofarm", "PCs obrigatorios concluidos!", "success")
                if FarmState.AutoExit then
                    doAutoExit()
                else
                    FarmState.EscapedThisRound = true
                end
                continue
            end

            local sg = LP:FindFirstChild("PlayerGui") and LP.PlayerGui:FindFirstChild("ScreenGui")
            if sg and sg:FindFirstChild("TimingCircle") and sg.TimingCircle.Visible then
                RemoteEvent:FireServer("Input", "Action", true)
                RemoteEvent:FireServer("SetPlayerMinigameResult", true)
                task.wait(0.12)
                continue
            end

            local computers = getAvailableComputers()
            if #computers == 0 then
                for k, t in pairs(finishedComputerKeys) do
                    if os.clock() - t > FINISHED_MEMORY then
                        finishedComputerKeys[k] = nil
                    end
                end
                notify("Autofarm", "Nenhum PC disponivel", "computer")
                if FarmState.AutoExit and not FarmState.EscapedThisRound then
                    doAutoExit()
                    continue
                end
                task.wait(1.5)
                continue
            end

            -- sem bonus: se ComputersLeft == 0 nao pega PC extra
            if shouldStopForRequiredPCs() then
                if FarmState.AutoExit and not FarmState.EscapedThisRound then
                    doAutoExit()
                else
                    FarmState.EscapedThisRound = true
                end
                continue
            end

            local computer = pickBestComputer(computers, lastTriedKey)
            if not computer then
                task.wait(0.5)
                continue
            end

            local thisKey = computerPosKey(computer)
            local trigger = getFreeTrigger(computer)

            -- se os 3 triggers estao ocupados: tenta outro PC; se nao tiver, espera alguem sair
            if not trigger then
                local hasOtherFree = false
                for _, c in ipairs(computers) do
                    if computerPosKey(c) ~= thisKey and not areAllTriggersOccupied(c) then
                        hasOtherFree = true
                        break
                    end
                end
                if hasOtherFree then
                    lastTriedKey = thisKey
                    task.wait(0.35)
                    continue
                end
                -- sem outro PC livre: fica neste ate liberar um lado (sem notify)
                while FarmState.AutoFarmComputers and scriptRunning do
                    if isComputerDone(computer) then break end
                    trigger = getFreeTrigger(computer)
                    if trigger then break end
                    -- se apareceu outro PC com slot livre, vai pra ele
                    local compsNow = getAvailableComputers()
                    local otherOpened = false
                    for _, c in ipairs(compsNow) do
                        if computerPosKey(c) ~= thisKey and not areAllTriggersOccupied(c) then
                            otherOpened = true
                            break
                        end
                    end
                    if otherOpened then
                        lastTriedKey = thisKey
                        break
                    end
                    task.wait(0.45)
                end
                if not trigger then
                    task.wait(0.2)
                    continue
                end
            end

            -- sempre espera o cooldown apos terminar um PC antes de ir pro proximo
            local agora = os.clock()
            local tempoRestante = (FarmState.COMPUTER_TP_COOLDOWN or 5) - (agora - (FarmState.lastComputerTP or 0))
            if tempoRestante > 0 then
              --  notify("Autofarm", string.format("CD %.1fs...", tempoRestante), "computer")
                task.wait(tempoRestante)
            end

            if not FarmState.AutoFarmComputers then break end

            notify("Autofarm", "Indo pro PC...", "computer")
            local standPos = getComputerStandPos(computer, trigger)
            teleportTo(standPos or trigger)
            task.wait(0.4)
            fireComputerInteract(trigger)
            task.wait(0.35)

            -- lastTriedKey so e setado ao terminar/abandonar/timeout (evita troca sem motivo)
            FarmState.NeedReinteract = false
            local timeout = os.clock() + 150
            local abandoned = false
            local finishedHere = false
            local fleeSwitchTime = 6
            local safeConfirm = 0.8
            local elevateY = 16
            local pcOrbitRadius = 12
            local dodgePhase = 0
            local lastDodgeT = 0

            -- Sobe + gira na borda do range do PC (oposto a fera)
            local function elevateAwayFromBeast()
                if not HRP or not HRP.Parent then return end
                local base = standPos or HRP.Position
                local bpos = getBeastPosition()
                local awayDir = Vector3.new(1, 0, 0)
                if bpos then
                    local d = Vector3.new(base.X - bpos.X, 0, base.Z - bpos.Z)
                    if d.Magnitude > 0.15 then awayDir = d.Unit end
                end
                local sideDir = Vector3.new(-awayDir.Z, 0, awayDir.X)
                local now = os.clock()
                if (now - lastDodgeT) >= 0.1 then
                    lastDodgeT = now
                    dodgePhase = dodgePhase + 1
                end
                local swing = ((dodgePhase % 10) / 9) * 2 - 1
                local angle = swing * 1.22
                local dir = awayDir * math.cos(angle) + sideDir * math.sin(angle)
                if dir.Magnitude > 0.05 then dir = dir.Unit else dir = awayDir end
                local target = base + dir * pcOrbitRadius + Vector3.new(0, elevateY, 0)
                HRP.CFrame = CFrame.lookAt(target, Vector3.new(base.X, target.Y, base.Z))
                HRP.AssemblyLinearVelocity = Vector3.zero
                HRP.AssemblyAngularVelocity = Vector3.zero
            end

            local function clearTpCooldown()
                local cd = FarmState.COMPUTER_TP_COOLDOWN or 5
                FarmState.lastComputerTP = os.clock() - cd
            end

            while FarmState.AutoFarmComputers and scriptRunning and os.clock() < timeout do
                -- salvando capturado (XP): pausa o spam de Action pra nao brigar com o evento da capsula
                if FarmState.Saving then
                    task.wait(0.05)
                    continue
                end
                -- terminou de salvar: solta o Action, volta pro lado do PC e reinicia o hack
                if FarmState.NeedReinteract then
                    FarmState.NeedReinteract = false
                    pcall(function() RemoteEvent:FireServer("Input", "Action", false) end)
                    task.wait(0.1)
                    if standPos and HRP and HRP.Parent then
                        HRP.CFrame = CFrame.new(standPos)
                        HRP.AssemblyLinearVelocity = Vector3.zero
                        HRP.AssemblyAngularVelocity = Vector3.zero
                    end
                    task.wait(0.15)
                    fireComputerInteract(trigger)
                    task.wait(0.3)
                end

                if isComputerDone(computer) then
                    notify("Autofarm", "PC concluido!", "success")
                    markComputerFinished(computer)
                    lastTriedKey = thisKey
                    finishedHere = true
                    FarmState.lastComputerTP = os.clock()
                    local cd = FarmState.COMPUTER_TP_COOLDOWN or 5
                    notify("Autofarm", string.format("CD %ds antes do proximo...", cd), "computer")

                    if shouldStopForRequiredPCs() then
                        notify("Autofarm", "PCs obrigatorios ok!", "success")
                        if FarmState.AutoExit and not FarmState.EscapedThisRound then
                            doAutoExit()
                        else
                            FarmState.EscapedThisRound = true
                        end
                    end
                    break
                end

                -- Fera no range: distancia calculada do standPos do PC (nao do boneco no ar)
                if FarmState.AutoDetectBeast and standPos and isBeastNear(FarmState.BeastSafeDistance or 40, standPos) then
                    notify("Autofarm", "Fera no range! Saindo do hack...", "computer")
                    FarmState.lastComputerTP = os.clock()
                    elevateAwayFromBeast()

                    local waitStart = os.clock()
                    local outSince = nil
                    local resumed = false

                    while FarmState.AutoFarmComputers and scriptRunning do
                        if HRP and HRP.Parent and standPos then
                            elevateAwayFromBeast()
                        end

                        local nearNow = standPos and isBeastNear(FarmState.BeastSafeDistance or 40, standPos)
                        if nearNow then
                            outSince = nil
                            if (os.clock() - waitStart) >= fleeSwitchTime then
                                notify("Autofarm", "Fera ainda perto. Trocando de PC...", "computer")
                                lastTriedKey = thisKey
                                abandoned = true
                                clearTpCooldown()
                                break
                            end
                        else
                            -- fera saiu do range do PC -> volta e CONTINUA no mesmo PC
                            if not outSince then
                                outSince = os.clock()
                            elseif (os.clock() - outSince) >= safeConfirm then
                                notify("Autofarm", "Fera saiu. Voltando pro PC...", "computer")
                                if standPos and HRP then
                                    HRP.CFrame = CFrame.new(standPos)
                                    HRP.AssemblyLinearVelocity = Vector3.zero
                                    HRP.AssemblyAngularVelocity = Vector3.zero
                                elseif trigger then
                                    teleportTo(trigger)
                                end
                                task.wait(0.25)
                                fireComputerInteract(trigger)
                                resumed = true
                                break
                            end
                        end
                        task.wait(0.12)
                    end

                    if abandoned then
                        break
                    end
                    if not resumed then
                        -- saiu do loop sem resume e sem abandon (ex: desligou farm) -> nao troca de PC
                        break
                    end
                    -- retomou: continua no MESMO pc (nao marca lastTriedKey, nao troca)
                end

                RemoteEvent:FireServer("Input", "Action", true)
                RemoteEvent:FireServer("SetPlayerMinigameResult", true)
                fireComputerInteract(trigger)

                if hasPlayerNear(HRP.Position, 4.5) then
                    local newTrigger = getFreeTrigger(computer, trigger)
                    if newTrigger and newTrigger ~= trigger and not hasPlayerNear(newTrigger.Position, 4.5) then
                        trigger = newTrigger
                        local sidePos = getComputerStandPos(computer, trigger)
                        if sidePos then
                            standPos = sidePos -- atualiza referencia do range
                        end
                        if sidePos and HRP and (sidePos - HRP.Position).Magnitude < 20 then
                            HRP.CFrame = CFrame.new(sidePos)
                            HRP.AssemblyLinearVelocity = Vector3.zero
                            fireComputerInteract(trigger)
                            notify("Autofarm", "Trocando de lado...", "computer")
                        end
                    end
                end

                task.wait(0.08)
            end

            if not FarmState.AutoFarmComputers then break end

            -- so vai pro proximo PC se terminou ou abandonou por fera
            -- timeout / saida estranha: tenta de novo o mesmo (nao troca sem motivo)
            if finishedHere then
                task.wait(0.25)
            elseif abandoned then
                task.wait(0.1)
            elseif os.clock() >= timeout then
                notify("Autofarm", "Timeout no PC, tentando outro...", "computer")
                lastTriedKey = thisKey
                FarmState.lastComputerTP = os.clock()
                task.wait(0.2)
            else
                -- saida inesperada: nao marca como tentado, pode voltar no mesmo PC
                lastTriedKey = nil
                task.wait(0.15)
            end
        end

        FarmState.AutoFarmBusy = false
    end)
end

