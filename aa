local function isBeastNear(distance, fromPos)
    -- fromPos = posição de referência (ex: standPos do PC). Se nil, usa HRP.
    local bpos = getBeastPosition()
    if not bpos then return false end
    local checkPos = fromPos
    if not checkPos then
        if not HRP then return false end
        checkPos = HRP.Position
    end
    return (bpos - checkPos).Magnitude <= distance
end

