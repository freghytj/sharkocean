local notifOrder = 0

local function notify(title, message, kind, duration)
    if not notificationsEnabled then return end
    kind = kind or "info"
    -- filtros por tipo
    if kind == "toggle" and not NotifFilters.toggles then return end
    if kind == "action" and not NotifFilters.actions then return end
    if kind == "keybind" and not NotifFilters.keybinds then return end
    if kind == "save" and not NotifFilters.saves then return end
    if kind == "status" and not NotifFilters.status then return end
    if kind == "computer" and not NotifFilters.computers then return end
    if (kind == "info" or kind == "success" or kind == "system" or kind == "error") and not NotifFilters.system and kind ~= "error" then
        if kind == "system" or kind == "info" or kind == "success" then
            -- system filter controls generic system toasts; errors always show if enabled overall
            if kind ~= "error" and not NotifFilters.system then return end
        end
    end
    if kind == "system" and not NotifFilters.system then return end
    if kind == "info" and not NotifFilters.system then return end
    if kind == "success" and not NotifFilters.system then return end

    notifOrder = notifOrder + 1
    duration = duration or 3
    local accent = theme.Accent
    if kind == "error" then accent = theme.Danger
    elseif kind == "success" then accent = Color3.fromRGB(80, 200, 120)
    elseif kind == "save" then accent = Color3.fromRGB(80, 200, 120)
    elseif kind == "status" then accent = Color3.fromRGB(255, 200, 60)
    elseif kind == "toggle" then accent = theme.Accent
    elseif kind == "action" then accent = Color3.fromRGB(130, 160, 255)
    elseif kind == "computer" then accent = Color3.fromRGB(40, 180, 220)
    end

    local card = Instance.new("Frame", notifHolder)
    card.Size = UDim2.new(1, 0, 0, message and 58 or 44)
    card.BackgroundColor3 = theme.NotifBG
    card.BackgroundTransparency = 1
    card.BorderSizePixel = 0
    card.LayoutOrder = notifOrder
    card.ZIndex = 50
    card.ClipsDescendants = true
    corner(card, 10)
    local cStroke = stroke(card, Color3.fromRGB(45, 48, 56), 1, 1)

    local glassN = Instance.new("Frame", card)
    glassN.Size = UDim2.new(1, 0, 1, 0)
    glassN.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    glassN.BackgroundTransparency = 1
    glassN.BorderSizePixel = 0
    glassN.ZIndex = 50
    corner(glassN, 10)
    local gN = Instance.new("UIGradient", glassN)
    gN.Rotation = 90
    gN.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(180, 190, 210))
    gN.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.94),
        NumberSequenceKeypoint.new(1, 1)
    })

    local inner = Instance.new("Frame", card)
    inner.Size = UDim2.new(1, 0, 1, 0)
    inner.Position = UDim2.new(0, 0, 0, 18)
    inner.BackgroundTransparency = 1
    inner.ZIndex = 51

    local bar = Instance.new("Frame", inner)
    bar.AnchorPoint = Vector2.new(0, 0.5)
    bar.Position = UDim2.new(0, 10, 0.5, 0)
    bar.Size = UDim2.new(0, 3, 1, -16)
    bar.BackgroundColor3 = accent
    bar.BackgroundTransparency = 1
    bar.BorderSizePixel = 0
    bar.ZIndex = 52
    corner(bar, 2)

    local ttl = Instance.new("TextLabel", inner)
    ttl.Text = title or "SHARK"
    ttl.Font = Enum.Font.BuilderSansBold
    ttl.TextSize = 14
    ttl.TextColor3 = theme.TextLight
    ttl.TextTransparency = 1
    ttl.TextXAlignment = Enum.TextXAlignment.Left
    ttl.TextTruncate = Enum.TextTruncate.AtEnd
    ttl.BackgroundTransparency = 1
    ttl.Position = UDim2.new(0, 22, 0, message and 8 or 0)
    ttl.Size = UDim2.new(1, -34, 0, message and 17 or 44)
    ttl.ZIndex = 52

    local msg
    if message then
        msg = Instance.new("TextLabel", inner)
        msg.Text = message
        msg.Font = Enum.Font.BuilderSans
        msg.TextSize = 12
        msg.TextColor3 = theme.TextMid
        msg.TextTransparency = 1
        msg.TextXAlignment = Enum.TextXAlignment.Left
        msg.TextTruncate = Enum.TextTruncate.AtEnd
        msg.BackgroundTransparency = 1
        msg.Position = UDim2.new(0, 22, 0, 26)
        msg.Size = UDim2.new(1, -34, 0, 17)
        msg.ZIndex = 52
    end

    local timerBar = Instance.new("Frame", card)
    timerBar.Size = UDim2.new(1, 0, 0, 2)
    timerBar.Position = UDim2.new(0, 0, 1, -2)
    timerBar.BackgroundColor3 = accent
    timerBar.BackgroundTransparency = 1
    timerBar.BorderSizePixel = 0
    timerBar.ZIndex = 53

    play(card, EASE_SLOW, {BackgroundTransparency = 0.06})
    play(cStroke, EASE_SLOW, {Transparency = 0.4})
    play(inner, TweenInfo.new(0.28, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
    play(bar, EASE_SLOW, {BackgroundTransparency = 0})
    play(ttl, EASE_SLOW, {TextTransparency = 0})
    if msg then play(msg, EASE_SLOW, {TextTransparency = 0}) end
    play(timerBar, EASE_SLOW, {BackgroundTransparency = 0.35})
    play(timerBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Size = UDim2.new(0, 0, 0, 2)})

    task.delay(duration, function()
        if not card.Parent then return end
        local out = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        play(inner, out, {Position = UDim2.new(0, 0, 0, 18)})
        play(card, out, {BackgroundTransparency = 1})
        play(cStroke, out, {Transparency = 1})
        play(bar, out, {BackgroundTransparency = 1})
        play(ttl, out, {TextTransparency = 1})
        if msg then play(msg, out, {TextTransparency = 1}) end
        play(timerBar, out, {BackgroundTransparency = 1})
        task.delay(0.24, function()
            if card.Parent then
                play(card, TweenInfo.new(0.14), {Size = UDim2.new(1, 0, 0, 0)})
                task.delay(0.15, function() if card.Parent then card:Destroy() end end)
            end
        end)
    end)
    return card
end

