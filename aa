local function balanceColumns(leftColumn, rightColumn)
    local hL, hR = 0, 0
    for i, s in ipairs(builtSections) do
        local items, h = 0, 42
        for _, child in pairs(s.container:GetChildren()) do
            if not child:IsA("UIListLayout") then items = items + 1; h = h + child.Size.Y.Offset end
        end
        if items > 1 then h = h + (items - 1) * 2 end
        s.frame.LayoutOrder = i
        if hL <= hR then
            s.frame.Parent = leftColumn
            hL = hL + h + 12
        else
            s.frame.Parent = rightColumn
            hR = hR + h + 12
        end
    end
end

local itemOrder = 0
local function nextOrder() itemOrder = itemOrder + 1; return itemOrder end

local currentHover
local function enterHover(obj, leaveFn)
    if currentHover and currentHover.obj ~= obj then
        local prev = currentHover; currentHover = nil; prev.leave()
    end
    currentHover = {obj = obj, leave = leaveFn}
end
local function exitHover(obj, leaveFn)
    if currentHover and currentHover.obj == obj then currentHover = nil end
    leaveFn()
end

local function listenForBind(chip, chipStroke, onSet, onCancel)
    KeybindListening = true
    chip.Text = "pressione..."
    play(chip, EASE, {TextColor3 = theme.Accent, BackgroundTransparency = 0})
    play(chipStroke, EASE, {Color = theme.Accent, Transparency = 0.15})
    local conn
    local function stop() KeybindListening = false; if conn then conn:Disconnect() end end
    conn = UIS.InputBegan:Connect(function(input)
        local t = input.UserInputType
        local newName
        if t == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.Escape then stop(); onCancel(); return end
            newName = input.KeyCode.Name
        elseif t == Enum.UserInputType.MouseButton3 then
            newName = "Mouse3"
        else
            local tn = tostring(t)
            if tn:find("MouseButton4") then newName = "Mouse4"
            elseif tn:find("MouseButton5") then newName = "Mouse5"
            else return end
        end
        stop()
        onSet(newName)
    end)
    chip.AncestryChanged:Connect(function(_, parent) if not parent and KeybindListening then stop() end end)
end

