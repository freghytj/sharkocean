end

local function isLocalPlayerInRound()
    local ok, result = pcall(function()
        local rb = getRoundBar()
        if not rb then return false end
        local bars = rb:FindFirstChild("StatusBars")
        if bars then
            for i = 1, 6 do
                local cell = bars:FindFirstChild("SurvivorCell" .. tostring(i))
                if cell then
                    local nl = cell:FindFirstChild("NameLabel")
                    if nl and tostring(nl.Text) == LP.Name then return true end
                end
            end
        end
        for _, d in ipairs(rb:GetDescendants()) do
            if d.Name == "NameLabel" and d:IsA("TextLabel") and tostring(d.Text) == LP.Name then
                return true
            end
        end
        return false
    end)
    return ok and result == true
end

local function countRoundSurvivors()
    local n = 0
    pcall(function()
        local rb = getRoundBar()
        if not rb then return end
        local seen = {}
        local bars = rb:FindFirstChild("StatusBars")
        if bars then
            for i = 1, 6 do
                local cell = bars:FindFirstChild("SurvivorCell" .. tostring(i))
                if cell then
                    local nl = cell:FindFirstChild("NameLabel")
                    local t = nl and tostring(nl.Text) or ""
                    if t ~= "" and t ~= "nil" and not seen[t] then
                        seen[t] = true
                        n = n + 1
                    end
                end
            end
        end
        if n == 0 then
            for _, d in ipairs(rb:GetDescendants()) do
                if d.Name == "NameLabel" and d:IsA("TextLabel") then
                    local t = tostring(d.Text)
                    if t ~= "" and t ~= "nil" and not seen[t] then
                        seen[t] = true
                        n = n + 1
                    end
                end
            end
        end
    end)
    return n
end

