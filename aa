                    listening = false; KeybindListening = false; conn:Disconnect()
                end
            end)
        end)
        UIS.InputBegan:Connect(function(inp, gpe)
            if not gpe and not listening and inp.KeyCode == UserKeys[keyID] then toggleAction() end
        end)
    end
    if default then active = true; apply(false) end -- visual only; don't fire callback on rebuild
    return btn
end


