local function pickBestExitDoor(excludeDoors)
    excludeDoors = excludeDoors or {}
    local doors = getExitDoors()
    if #doors == 0 then return nil end
    local bpos = getBeastPosition()
    local safeDist = tonumber(FarmState.BeastSafeDistance) or 40
    local openDoors, closedDoors = {}, {}
    for _, d in ipairs(doors) do
        if not excludeDoors[d] then
            if isDoorOpen(d) then table.insert(openDoors, d)
            else table.insert(closedDoors, d) end
        end
    end
    local function doorPos(d) return d:GetPivot().Position end
    local function score(d)
        local p = doorPos(d)
        local distPlayer = HRP and (p - HRP.Position).Magnitude or 0
        local distBeast = bpos and (p - bpos).Magnitude or 9999
        return distBeast * 3 - distPlayer
    end
    local function bestOf(list)
        if #list == 0 then return nil end
        table.sort(list, function(a, b) return score(a) > score(b) end)
        for _, d in ipairs(list) do
            local p = doorPos(d)
            if not bpos or (p - bpos).Magnitude > safeDist then return d end
        end
        return list[1]
    end
    local pick = bestOf(openDoors) or bestOf(closedDoors)
    if not pick then return nil end
    return pick, isDoorOpen(pick)
end
