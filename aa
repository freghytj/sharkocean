            play(chip, EASE, {BackgroundTransparency = 0.2})
            play(chipStroke, EASE, {Color = theme.Divider, Transparency = 0.3})
        end
        refresh()

        chip.MouseButton1Click:Connect(function()
            if KeybindListening then return end
            listenForBind(chip, chipStroke,
                function(name) bindSet(name); refresh(); notify(text, "Tecla: " .. name, "info") end,
                function() refresh() end
            )
        end)
        chip.MouseButton2Click:Connect(function()
            if KeybindListening then return end
            if bindGet() then bindSet(nil); refresh(); notify(text, "Atalho removido", "info") end
        end)
    end

    return btn
end

