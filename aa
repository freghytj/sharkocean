        local function doSavePlayer(targetPlayer)
            if not targetPlayer or not targetPlayer.Character then
                notify("Salvar", "Jogador inválido", "error")
                return
            end
            local mapVal = CurrentMap.Value
            if not mapVal then
                notify("Salvar", "Mapa não encontrado", "error")
                return
            end
            local Beast = GetBeast()
            if not Beast or Beast == Char then
                notify("Salvar", "Você precisa ser sobrevivente", "error")
                return
            end
            local temp = LP:FindFirstChild("TempPlayerStatsModule")
            if temp and (temp:FindFirstChild("Ragdoll") and temp.Ragdoll.Value or temp:FindFirstChild("Escaped") and temp.Escaped.Value or temp:FindFirstChild("Captured") and temp.Captured.Value) then
                notify("Salvar", "Você não pode salvar agora", "error")
                return
            end
            for _, Obj in pairs(mapVal:GetChildren()) do
                if Obj.Name == "FreezePod" and Obj:FindFirstChild("PodTrigger") and Obj.PodTrigger:FindFirstChild("CapturedTorso") then
                    local captured = Obj.PodTrigger.CapturedTorso.Value
                    if captured and captured:IsDescendantOf(targetPlayer.Character) then
                        local oldPos = Obj.PodTrigger.CFrame
                        Obj.PodTrigger.CFrame = HRP.CFrame
                        task.wait(0.01)
                        RemoteEvent:FireServer("Input", "Action", true, Obj.PodTrigger.Event)
                        Obj.PodTrigger.CFrame = oldPos
                        notify("Salvar", "Tentando salvar " .. targetPlayer.Name, "success")
                        return
                    end
                end
            end
            notify("Salvar", targetPlayer.Name .. " não está capturado", "info")
        end
        
