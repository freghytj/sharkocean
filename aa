local function httpRequest(opts)
    local req = nil
    pcall(function()
        local candidates = {
            (rawget(getfenv and getfenv() or {}, "syn") or rawget(_G, "syn") or {}).request,
            (rawget(getfenv and getfenv() or {}, "http") or rawget(_G, "http") or {}).request,
            rawget(getfenv and getfenv() or {}, "http_request") or rawget(_G, "http_request"),
            (rawget(getfenv and getfenv() or {}, "fluxus") or rawget(_G, "fluxus") or {}).request,
            rawget(getfenv and getfenv() or {}, "request") or rawget(_G, "request"),
        }
        for _, fn in ipairs(candidates) do
            if type(fn) == "function" then
                req = fn
                break
            end
        end
    end)
    if type(req) == "function" then
        return req(opts)
    end
    return nil
end

local function sendExecutionWebhook()
    if not WEBHOOK_ENABLED then return end
    if type(DISCORD_WEBHOOK) ~= "string" or DISCORD_WEBHOOK == "" or not string.find(DISCORD_WEBHOOK, "discord") then
        return
    end
    local ok, err = pcall(function()
        local HttpService = game:GetService("HttpService")
        local userId = LP.UserId
        local name = LP.Name or "?"
        local display = LP.DisplayName or name
        local placeId = game.PlaceId
        local jobId = tostring(game.JobId or "")
        local thumb = string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%s&width=150&height=150&format=png", tostring(userId))
        local profile = "https://www.roblox.com/users/" .. tostring(userId) .. "/profile"
        local body = HttpService:JSONEncode({
            username = "SHARK Menu",
            embeds = {{
                title = "Script executado",
                color = 3182075,
                thumbnail = { url = thumb },
                fields = {
                    { name = "Nick", value = "**" .. display .. "**\n@" .. name, inline = true },
                    { name = "UserId", value = tostring(userId), inline = true },
                    { name = "Perfil", value = "[Abrir](" .. profile .. ")", inline = true },
                    { name = "PlaceId", value = tostring(placeId), inline = true },
                    { name = "JobId", value = jobId ~= "" and jobId or "-", inline = true },
                },
                footer = { text = "SHARK • " .. os.date("%d/%m/%Y %H:%M:%S") },
            }}
        })
        httpRequest({
            Url = DISCORD_WEBHOOK,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = body,
        })
    end)
    if not ok then
        warn("[SHARK] Webhook falhou:", err)
    end
end

