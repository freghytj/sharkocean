local SaveFirstState = { Done = false, Attempts = 0 }

local function resetSaveFirst()
    SaveFirstState.Done = false
    SaveFirstState.Attempts = 0
end
IsGameActive.Changed:Connect(function(v) if not v then resetSaveFirst() end end)
CurrentMap.Changed:Connect(resetSaveFirst)

local function getCapturedTargets()
    local list = {}
    local mapVal = CurrentMap.Value
    if not mapVal then return list end
    for _, Obj in ipairs(mapVal:GetChildren()) do
        if Obj.Name == "FreezePod" then
            local trig = Obj:FindFirstChild("PodTrigger")
            local torsoVal = trig and trig:FindFirstChild("CapturedTorso")
            local torso = torsoVal and torsoVal.Value
            if torso then
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP and p.Character and torso:IsDescendantOf(p.Character) then
                        local temp = p:FindFirstChild("TempPlayerStatsModule")
                        local cap = temp and temp:FindFirstChild("Captured")
                        if cap and cap.Value == true and getPlayerStatus(p) ~= "Rival" then
                            table.insert(list, { player = p, pod = Obj })
                        end
                        break
                    end
                end
            end
        end
    end
    return list
end

local function fireSavePod(pod)
    local trig = pod and pod:FindFirstChild("PodTrigger")
    if not trig or not HRP or not HRP.Parent then return end
    local oldPos = trig.CFrame
    trig.CFrame = HRP.CFrame
    task.wait(0.01)
    pcall(function() RemoteEvent:FireServer("Input", "Action", true, trig.Event) end)
    trig.CFrame = oldPos
end

-- ja soltou da capsula? (Captured desligou OU a capsula nao segura mais o corpo dele)
local function podIsFreed(target)
    local temp = target.player:FindFirstChild("TempPlayerStatsModule")
    local cap = temp and temp:FindFirstChild("Captured")
    if cap and cap.Value == false then return true end
    local trig = target.pod and target.pod:FindFirstChild("PodTrigger")
    local torsoVal = trig and trig:FindFirstChild("CapturedTorso")
    local torso = torsoVal and torsoVal.Value
    local char = target.player.Character
    if not torso or not char or not torso:IsDescendantOf(char) then return true end
    return false
end

local function amIDown()
    local tempMe = LP:FindFirstChild("TempPlayerStatsModule")
    if not tempMe then return false end
    for _, n in ipairs({ "Ragdoll", "Escaped", "Captured" }) do
        local v = tempMe:FindFirstChild(n)
        if v and v.Value == true then return true end
    end
    return false
end

task.spawn(function()
    while scriptRunning do
        pcall(function()
            if not (FarmState.SaveFirstCaptured and FarmState.AutoFarmComputers) then return end
            if SaveFirstState.Done or not IsGameActive.Value then return end
            if not isLocalPlayerInRound() or isLocalPlayerBeast() then return end
            local tempMe = LP:FindFirstChild("TempPlayerStatsModule")
            if tempMe then
                for _, n in ipairs({ "Ragdoll", "Escaped", "Captured" }) do
