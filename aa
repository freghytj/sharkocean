    if statusIsLobbyOrTransition() then return false end
    if string.find(s, "COMPUTERS LEFT", 1, true) then return true end
    if string.find(s, "HEAD START", 1, true) then return true end
    if string.find(s, "FIND A EXIT", 1, true) then return true end
    if string.find(s, "IN GAME", 1, true) then return true end
    if string.find(s, "ROUND", 1, true) then return true end
    return true
end

local function sharkHttpGet(url)
    local body = nil
    pcall(function()
        if type(game.HttpGet) == "function" then body = game:HttpGet(url) end
    end)
    if type(body) == "string" and #body > 5 then return body end
    pcall(function()
        local reqFn = rawget(_G, "request") or rawget(_G, "http_request")
            or (type(syn) == "table" and syn.request)
            or (type(http) == "table" and http.request)
            or (type(fluxus) == "table" and fluxus.request)
        if type(reqFn) == "function" then
            local r = reqFn({ Url = url, Method = "GET" })
            if type(r) == "table" then body = r.Body or r.body
            elseif type(r) == "string" then body = r end
        end
    end)
    return body
end

