                if child.Name == "ErrorPrompt" then onKicked() end
            end)
        end)
    end)
end

-- Auto Server Hop
-- - INTERMISSION / GAME OVER / LOADING: fica
-- - Partida rolando e você FORA da RoundBar: hop (mesmo com AutoFarm ligado)
-- - Você jogou e acabou: hop
task.spawn(function()
    task.wait(2)
    local wasIn = false
    local since = nil
    local iconSince = nil
    local pcsDone = false
    while scriptRunning do
        local ok, err = pcall(function()
            -- IsBeast ligado em mim: nao quero ser fera -> hopa SEMPRE (mesmo com Auto Server Hop desligado)
            do
                local tempMe = LP:FindFirstChild("TempPlayerStatsModule")
                local beastVal = tempMe and tempMe:FindFirstChild("IsBeast")
                if beastVal and beastVal.Value == true and not FarmState.Hopping then
                    notify("Server Hop", "Voce e a fera! Trocando de servidor...", "system")
                    doServerHop(true)
                    return
                end
            end

            if not FarmState.AutoServerHop then
                since = nil
                return
            end
            if FarmState.Hopping then return end

            local lobby = statusIsLobbyOrTransition()
            local ingame = statusIsInGame()
            local imIn = isLocalPlayerInRound()
            local survivors = countRoundSurvivors()
            local imBeast = isLocalPlayerBeast()

            if imIn then
                wasIn = true
                since = nil
            end

            -- Anti-Fera: se for a fera, hopa
            if FarmState.AntiBeast and imBeast then
                doServerHop()
                return
            end

            -- icone do meu card diferente do normal (so no meio da partida, enquanto ainda ha PC pra fazer) -> hop
            if not IsGameActive.Value or lobby then pcsDone = false end
            if imIn and IsGameActive.Value and not lobby and not pcsDone then
                local img = getMyStatusIconImage()
                local abnormal = img ~= nil and not isNormalStatusIcon(img)
                if abnormal and not farmingPCsStillPending() then
                    -- PCs acabaram: icone muda por causa da saida/porta, para de checar ate a proxima partida
                    pcsDone = true
                    abnormal = false
                end
                if abnormal then
                    if not iconSince then
                        iconSince = os.clock()
                    elseif (os.clock() - iconSince) >= 1.5 then
                        iconSince = nil
                        notify("Server Hop", "Seu icone mudou. Trocando de servidor...", "system")
                        doServerHop()
                        return
                    end
                else
                    iconSince = nil
                end
            else
                iconSince = nil
            end

            -- tem gente na RoundBar OU status de partida, e você NÃO está nela → hop
            local matchWithoutMe = (survivors > 0 and not imIn) or (ingame and not imIn)
            if matchWithoutMe then
                if not since then
                    since = os.clock()
                elseif (os.clock() - since) >= 2.5 then
                    since = nil
                    doServerHop()
                    return
                end
            else
                since = nil
            end

            -- participou e a rodada acabou
            if wasIn and lobby and not imIn then
                wasIn = false
                doServerHop()
                return
            end
        end)
        if not ok then warn("[SHARK] ServerHop:", err) end
        task.wait(0.5)
    end
end)

pcall(function()
    if type(getgenv) == "function" then
        getgenv().SharkNotify = notify
    else
        rawset(_G, "SharkNotify", notify)
    end
end)
