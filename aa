local function getTriggers(computer)
    local triggers = {}
    if not computer then return triggers end
    for _, desc in ipairs(computer:GetDescendants()) do
        if desc:IsA("BasePart") then
            local n = desc.Name
            if n == "ComputerTrigger1" or n == "ComputerTrigger2" or n == "ComputerTrigger3" then
                table.insert(triggers, desc)
            end
        end
    end
    table.sort(triggers, function(a, b) return a.Name < b.Name end)
    return triggers
end

local function hasPlayerNear(pos, radius)
    radius = radius or 6
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if (p.Character.HumanoidRootPart.Position - pos).Magnitude <= radius then
                return true
            end
        end
    end
    return false
end

local function areAllTriggersOccupied(computer)
    local triggers = getTriggers(computer)
    if #triggers == 0 then return true end
    for _, trigger in ipairs(triggers) do
        if not hasPlayerNear(trigger.Position, 4.5) then
            return false
        end
    end
    return true
end

local function getFreeTrigger(computer, currentTrigger)
    local triggers = getTriggers(computer)
    if #triggers == 0 then return nil end

    -- tenta os 3 triggers; se currentTrigger, prioriza o proximo lado
    if currentTrigger then
        local currentNum = tonumber(string.match(currentTrigger.Name, "%d+")) or 1
        local nextNum = currentNum % 3 + 1
        for _, t in ipairs(triggers) do
            local num = tonumber(string.match(t.Name, "%d+")) or 0
            if num == nextNum and not hasPlayerNear(t.Position, 4.5) then
                return t
            end
        end
    end

    for _, trigger in ipairs(triggers) do
        if not hasPlayerNear(trigger.Position, 4.5) then
            return trigger
        end
    end

    -- os 3 estao ocupados
    return nil
end

