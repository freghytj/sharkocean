    btn.MouseLeave:Connect(function() exitHover(btn, leave) end)
    btn.MouseButton1Down:Connect(function() play(btn, TweenInfo.new(0.07), {BackgroundTransparency = 0.86}) end)
    btn.MouseButton1Up:Connect(function() if currentHover and currentHover.obj == btn then play(btn, EASE, {BackgroundTransparency = 0.93}) else leave() end end)
    btn.MouseButton1Click:Connect(function() if callback then callback() else notify(text, "Executado", "action") end end)

    if bindGet then
        local chip = Instance.new("TextButton", btn)
        chip.AnchorPoint = Vector2.new(1, 0.5)
        chip.Position = UDim2.new(1, -8, 0.5, 0)
