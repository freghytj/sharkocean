    local function update(input, anim)
        local relativeX = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
        local value = math.floor(min + ((max - min) * relativeX) + 0.5)
        local info = anim and TweenInfo.new(0.08) or TweenInfo.new(0.05)
        play(fill, info, {Size = UDim2.new(relativeX, 0, 1, 0)})
        play(knob, info, {Position = UDim2.new(relativeX, 0, 0.5, 0)})
        valLabel.Text = tostring(value)
        if callback then callback(value) end
    end

    sliderBg.MouseEnter:Connect(function() play(knobScale, EASE, {Scale = 1.25}) end)
    sliderBg.MouseLeave:Connect(function() if not dragging then play(knobScale, EASE, {Scale = 1}) end end)
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true; play(knobScale, EASE, {Scale = 1.35}); update(input, true) end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 and dragging then dragging = false; play(knobScale, EASE, {Scale = 1}) end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then update(input, false) end
    end)
    return frame
end

