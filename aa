    local HttpService = game:GetService("HttpService")
    local candidates = {}
    local cursor = ""

    local function pull(url)
        local body = sharkHttpGet(url)
        if type(body) ~= "string" or #body < 10 then
            pcall(function() body = game:HttpGet(url) end)
        end
        return body
    end

    for page = 1, 8 do
        local url = "https://games.roblox.com/v1/games/" .. tostring(placeId)
            .. "/servers/Public?sortOrder=Asc&limit=100"
        if cursor ~= "" then
            url = url .. "&cursor=" .. cursor
        end
        local body = pull(url)
        if type(body) ~= "string" or #body < 10 then break end
        local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
        if not ok or type(data) ~= "table" or type(data.data) ~= "table" then break end
        for _, server in ipairs(data.data) do
            local id = tostring(server.id or "")
            local playing = tonumber(server.playing) or 0
            local maxP = tonumber(server.maxPlayers) or 12
            local free = maxP - playing
            if id ~= "" and id ~= current and not exclude[id] and free >= 1 then
                table.insert(candidates, { id = id, free = free })
            end
        end
        cursor = tostring(data.nextPageCursor or "")
        if cursor == "" or #candidates >= 25 then break end
    end

    if #candidates < 5 then
        local body = pull("https://games.roblox.com/v1/games/" .. tostring(placeId) .. "/servers/Public?sortOrder=Desc&limit=100")
        if type(body) == "string" and #body > 10 then
            local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
            if ok and type(data) == "table" and type(data.data) == "table" then
                for _, server in ipairs(data.data) do
                    local id = tostring(server.id or "")
                    local playing = tonumber(server.playing) or 0
                    local maxP = tonumber(server.maxPlayers) or 12
                    local free = maxP - playing
                    if id ~= "" and id ~= current and not exclude[id] and free >= 1 then
                        local exists = false
                        for _, c in ipairs(candidates) do
                            if c.id == id then exists = true break end
                        end
                        if not exists then
                            table.insert(candidates, { id = id, free = free })
                        end
                    end
                end
            end
        end
    end

    if #candidates == 0 then return {} end
    table.sort(candidates, function(a, b) return a.free > b.free end)
    local list = {}
    for i, c in ipairs(candidates) do
        table.insert(list, c.id)
        if i >= 20 then break end
    end
    return list
end
