    local keyStroke
    if keyID then
        keyBtn.Size = UDim2.new(0, 52, 0, 18)
        keyBtn.AnchorPoint = Vector2.new(1, 0.5)
        keyBtn.Position = UDim2.new(1, -33, 0.5, 0)
