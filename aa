            local freed = false
            FarmState.Saving = true
            pcall(function()
                local t0 = os.clock()
                while os.clock() - t0 < 8 and scriptRunning and FarmState.AutoFarmComputers do
                    if not target.player.Parent or amIDown() then break end
                    fireSavePod(target.pod)
