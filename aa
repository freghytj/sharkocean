local function isColorClose(c1, c2, tol)
    tol = tol or 30
    return math.abs(c1.R * 255 - c2.R * 255) <= tol
       and math.abs(c1.G * 255 - c2.G * 255) <= tol
       and math.abs(c1.B * 255 - c2.B * 255) <= tol
end

local function getComputerScreen(computer)
    if not computer then return nil end
    local screen = computer:FindFirstChild("Screen", true)
    if screen and screen:IsA("BasePart") then return screen end
    return nil
end

local function computerPosKey(computer)
    local screen = getComputerScreen(computer)
    local pos = screen and screen.Position or (computer.GetPivot and computer:GetPivot().Position) or Vector3.zero
    return string.format("%.0f_%.0f_%.0f", pos.X, pos.Y, pos.Z)
end

local finishedComputerKeys = {}
local FINISHED_MEMORY = 90

local function markComputerFinished(computer)
    if not computer then return end
    finishedComputerKeys[computerPosKey(computer)] = os.clock()
    FarmState.lastFinishedComputer = computer
end

local function wasComputerRecentlyFinished(computer)
    local key = computerPosKey(computer)
    local t = finishedComputerKeys[key]
    if not t then return false end
    if os.clock() - t > FINISHED_MEMORY then
        finishedComputerKeys[key] = nil
        return false
    end
    return true
end

local function getAvailableComputers()
    local list = {}
    local map = CurrentMap.Value
    if not map then return list end

    for _, obj in ipairs(map:GetDescendants()) do
        if obj.Name == "ComputerTable" then
            local screen = getComputerScreen(obj)
            if screen then
                if isColorClose(screen.Color, COLOR_BLUE) or isColorClose(screen.Color, COLOR_RED) then
                    if not wasComputerRecentlyFinished(obj) then
                        table.insert(list, obj)
                    end
                end
            end
        end
    end
    return list
end

