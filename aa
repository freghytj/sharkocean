    end

    local function leave() play(btn, EASE, {BackgroundTransparency = 1}) end
    btn.MouseEnter:Connect(function() enterHover(btn, leave); play(btn, EASE, {BackgroundTransparency = 0.94}) end)
    btn.MouseLeave:Connect(function() exitHover(btn, leave) end)
    btn.MouseButton1Click:Connect(toggleAction)

