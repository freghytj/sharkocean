local SHARK_CONFIG_FILE = "SharkMenu_Config.json"

local function saveSharkConfig()
    pcall(function()
        local HttpService = game:GetService("HttpService")
        local data = {
            AutoFarmComputers = FarmState.AutoFarmComputers == true,
            AutoDetectBeast = FarmState.AutoDetectBeast == true,
            BeastSafeDistance = tonumber(FarmState.BeastSafeDistance) or 40,
            DoBonusPCs = FarmState.DoBonusPCs == true,
            SaveFirstCaptured = FarmState.SaveFirstCaptured == true,
            AutoExit = FarmState.AutoExit == true,
            AutoServerHop = FarmState.AutoServerHop == true,
            AntiBeast = FarmState.AntiBeast == true,
            OptimizeHub = OptimizeHub == true,
            notificationsEnabled = notificationsEnabled == true,
            blurEnabled = blurEnabled == true,
            MenuOpenKey = (MenuOpenKey and MenuOpenKey.Name) or "Insert",
        }
        local encoded = HttpService:JSONEncode(data)
        if type(writefile) == "function" then
            writefile(SHARK_CONFIG_FILE, encoded)
        end
        pcall(function()
            if type(getgenv) == "function" then
                getgenv().SharkMenuConfig = data
            else
                rawset(_G, "SharkMenuConfig", data)
            end
        end)
    end)
end

local function loadSharkConfig()
    pcall(function()
        local HttpService = game:GetService("HttpService")
        local raw = nil
        pcall(function()
            if type(isfile) == "function" and type(readfile) == "function" and isfile(SHARK_CONFIG_FILE) then
                raw = readfile(SHARK_CONFIG_FILE)
            end
        end)
        local data = nil
        if type(raw) == "string" and #raw > 2 then
            local okDecode, decoded = pcall(function()
                return HttpService:JSONDecode(raw)
            end)
            if okDecode then data = decoded end
        end
        if type(data) ~= "table" then
            pcall(function()
                if type(getgenv) == "function" and type(getgenv().SharkMenuConfig) == "table" then
                    data = getgenv().SharkMenuConfig
                elseif type(rawget(_G, "SharkMenuConfig")) == "table" then
                    data = rawget(_G, "SharkMenuConfig")
                end
            end)
        end
        if type(data) ~= "table" then return end

        if data.AutoFarmComputers ~= nil then FarmState.AutoFarmComputers = data.AutoFarmComputers and true or false end
        if data.AutoDetectBeast ~= nil then FarmState.AutoDetectBeast = data.AutoDetectBeast and true or false end
        if type(data.BeastSafeDistance) == "number" then FarmState.BeastSafeDistance = data.BeastSafeDistance end
        if data.DoBonusPCs ~= nil then FarmState.DoBonusPCs = data.DoBonusPCs and true or false end
        if data.SaveFirstCaptured ~= nil then FarmState.SaveFirstCaptured = data.SaveFirstCaptured and true or false end
        if data.AutoExit ~= nil then FarmState.AutoExit = data.AutoExit and true or false end
        if data.AutoServerHop ~= nil then FarmState.AutoServerHop = data.AutoServerHop and true or false end
        if data.AntiBeast ~= nil then FarmState.AntiBeast = data.AntiBeast and true or false end
        if data.OptimizeHub ~= nil then OptimizeHub = data.OptimizeHub and true or false end
        if data.notificationsEnabled ~= nil then notificationsEnabled = data.notificationsEnabled and true or false end
        if data.blurEnabled ~= nil then blurEnabled = data.blurEnabled and true or false end
        if type(data.MenuOpenKey) == "string" then
            local ok, key = pcall(function() return Enum.KeyCode[data.MenuOpenKey] end)
            if ok and key then MenuOpenKey = key end
        end
    end)
end

