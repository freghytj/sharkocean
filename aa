local function getInputBindName(input)
    local t = input.UserInputType
    if t == Enum.UserInputType.Keyboard then
        return input.KeyCode.Name
    elseif t == Enum.UserInputType.MouseButton1 then
        return "Mouse1"
    elseif t == Enum.UserInputType.MouseButton2 then
        return "Mouse2"
    elseif t == Enum.UserInputType.MouseButton3 then
        return "Mouse3"
    end
    -- Mouse4/5: evita Enum que alguns executors nao reconhecem
    local name = tostring(t)
    if name:find("MouseButton4") then return "Mouse4" end
    if name:find("MouseButton5") then return "Mouse5" end
    return nil
end

