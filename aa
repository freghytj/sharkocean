-- Helper: get candidates sorted by priority (Priority first, then Neutral, skip Rival when saving)
local function getSortedTargets(includeRival)
    local list = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LP and PlayerInGame(p.Name) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local st = getPlayerStatus(p)
            if includeRival or st ~= "Rival" then
                local prio = (st == "Priority") and 0 or (st == "Neutral" and 1 or 2)
                table.insert(list, {player = p, priority = prio, status = st})
            end
        end
    end
    table.sort(list, function(a, b) return a.priority < b.priority end)
    return list
end

