-- hook seguro (alguns executors nao tem hookmetamethod)
pcall(function()
    if type(hookmetamethod) ~= "function" then return end
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        if method == "FireServer" and tostring(self) == "RemoteEvent" and args[1] == "SetPlayerMinigameResult" and CombatState.NoHackFail then
