local function doServerHop(force)
    if FarmState.Hopping then return end
    if not (FarmState.AutoServerHop or force) then return end
    FarmState.Hopping = true
    notify("Server Hop", "Buscando servidor...", "system")

    local TS = game:GetService("TeleportService")
    local placeId = game.PlaceId
    local tried = {}

    task.spawn(function()
        local failed = false
        local failReason = ""
        local conn
        conn = TS.TeleportInitFailed:Connect(function(player, result, err)
            if player and player ~= LP then return end
            failed = true
            failReason = tostring(result and result.Name or err or "Failed")
        end)

        local function tryTP(jobId)
            local ok = false
            if jobId then
                ok = pcall(function() TS:TeleportToPlaceInstance(placeId, jobId, LP) end)
                if not ok then ok = pcall(function() TS:TeleportToPlaceInstance(placeId, jobId) end) end
            else
                ok = pcall(function() TS:Teleport(placeId, LP) end)
                if not ok then ok = pcall(function() TS:Teleport(placeId) end) end
            end
            return ok
        end

        local list = {}
        pcall(function()
            local r = findNewServerJobId(tried)
            if type(r) == "table" then list = r
            elseif type(r) == "string" then list = { r } end
        end)

        notify("Server Hop", "Achei " .. tostring(#list) .. " servidores. Tentando...", "system")

        local maxAttempts = 20
        local attempt = 0
        while attempt < maxAttempts and (FarmState.AutoServerHop or force) and scriptRunning do
            attempt = attempt + 1
            failed = false
            failReason = ""

            local jobId = list[attempt]
            if not jobId then
                -- busca lista de novo
                pcall(function()
                    local r = findNewServerJobId(tried)
                    if type(r) == "table" then
                        for _, id in ipairs(r) do table.insert(list, id) end
                    end
                end)
                jobId = list[attempt]
            end

            if jobId then
                tried[jobId] = true
                notify("Server Hop", "Teleport " .. attempt .. "/" .. maxAttempts .. " (" .. #list .. " sv)", "system")
                tryTP(jobId)
            else
                notify("Server Hop", "Fallback aleatorio " .. attempt .. "/" .. maxAttempts, "system")
                tryTP(nil)
            end

            local t0 = os.clock()
            while os.clock() - t0 < 5.5 and scriptRunning and (FarmState.AutoServerHop or force) do
                if failed then break end
                task.wait(0.2)
            end

            if failed then
                local r = string.lower(tostring(failReason))
                if string.find(r, "full", 1, true) or string.find(r, "gamefull", 1, true) then
                    notify("Server Hop", "Cheio. Proximo... (" .. attempt .. "/" .. maxAttempts .. ")", "system")
                    task.wait(0.4)
                else
                    notify("Server Hop", "Falhou (" .. tostring(failReason) .. "). Tentando...", "system")
                    task.wait(0.9)
                end
            else
                -- pode ter teleportado; se ainda aqui, continua tentando
                task.wait(0.6)
            end
        end

        if conn then conn:Disconnect() end
        FarmState.Hopping = false
        if (FarmState.AutoServerHop or force) and scriptRunning then
            notify("Server Hop", "Nao conseguiu entrar apos " .. attempt .. " tentativas", "error")
        end
    end)
end
