        local function playerListKey(filter)
            local names = {}
            local filterLower = filter and string.lower(filter) or ""
            for _, p in pairs(Players:GetPlayers()) do
                if filterLower == "" or string.find(string.lower(p.Name), filterLower, 1, true) or string.find(string.lower(p.DisplayName), filterLower, 1, true) then
                    table.insert(names, p.UserId .. ":" .. getPlayerStatus(p) .. ":" .. (CombatState.SelectedPlayer == p and "1" or "0"))
                end
            end
            table.sort(names)
            return table.concat(names, "|")
        end
        
