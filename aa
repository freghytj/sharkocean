    if string.find(s, "INTERMISSION", 1, true) then return true end
    if string.find(s, "GAME OVER", 1, true) then return true end
    if string.find(s, "LOADING", 1, true) then return true end
    if string.find(s, "WAITING", 1, true) then return true end
