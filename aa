    if computer.GetPivot then
        return computer:GetPivot().Position + Vector3.new(0, 3, 0)
    end
    return nil
end

-- fly/noclip RAPIDO: sobe na vertical, voa por cima ate o ponto e desce (nao atravessa o mapa inteiro)
local FLY_UP_SPEED = 260      -- subida (studs/s)
local FLY_SIDE_SPEED = 320    -- travessia por cima (studs/s)
local FLY_DOWN_SPEED = 260    -- descida (studs/s)
local FLY_EXTRA_HEIGHT = 35   -- altura acima do ponto mais alto (inicio/destino)
local FLY_EXIT_SPEED = 100    -- voo normal/mais lento, SO pra ir ate a saida (linha reta)

local function teleportTo(partOrPos, slow)
    if not HRP or not HRP.Parent then return end

    local targetPos
    if typeof(partOrPos) == "Vector3" then
        targetPos = partOrPos
    elseif typeof(partOrPos) == "Instance" and partOrPos:IsA("BasePart") then
        targetPos = partOrPos.Position + Vector3.new(0, 3, 0)
    else
        return
    end

    local startPos = HRP.Position
    local distance = (targetPos - startPos).Magnitude
    if distance < (slow and 3 or 25) then
        HRP.CFrame = CFrame.new(targetPos)
        HRP.AssemblyLinearVelocity = Vector3.zero
        HRP.AssemblyAngularVelocity = Vector3.zero
        return
    end

    -- noclip so durante o trajeto
    local colliders = {}
    if Char then
        for _, part in ipairs(Char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                colliders[#colliders + 1] = part
                part.CanCollide = false
            end
        end
    end

    local waypoints
    if slow then
        -- saida: voo normal em linha reta, velocidade moderada (rapido demais nao detecta)
        waypoints = { { targetPos, FLY_EXIT_SPEED } }
    else
        -- rota: sobe -> voa por cima do PC -> desce
        local topY = math.max(startPos.Y, targetPos.Y) + FLY_EXTRA_HEIGHT
        waypoints = {
            { Vector3.new(startPos.X, topY, startPos.Z), FLY_UP_SPEED },
            { Vector3.new(targetPos.X, topY, targetPos.Z), FLY_SIDE_SPEED },
            { targetPos, FLY_DOWN_SPEED },
        }
    end

    local totalTime = 0
    do
        local prev = startPos
        for _, wp in ipairs(waypoints) do
            totalTime = totalTime + (wp[1] - prev).Magnitude / wp[2]
            prev = wp[1]
        end
    end

    local rot = HRP.CFrame.Rotation
    local cur = startPos
    local idx = 1
    local done = false
    local conn
    local t0 = os.clock()

    conn = RS.Heartbeat:Connect(function(dt)
        if done or not FarmState.AutoFarmComputers or not scriptRunning or not HRP or not HRP.Parent then
            done = true
            if conn then conn:Disconnect() end
            return
        end

        local budget = dt
        while budget > 0 and idx <= #waypoints do
            local dest, speed = waypoints[idx][1], waypoints[idx][2]
            local toDest = dest - cur
            local dist = toDest.Magnitude
            local step = speed * budget
            if dist <= step then
                cur = dest
                budget = budget - (dist / speed)
                idx = idx + 1
            else
                cur = cur + toDest.Unit * step
                budget = 0
            end
        end

        HRP.CFrame = CFrame.new(cur) * rot
        HRP.AssemblyLinearVelocity = Vector3.zero
        HRP.AssemblyAngularVelocity = Vector3.zero

        if idx > #waypoints then
            done = true
            if conn then conn:Disconnect() end
        end
    end)

    while not done and FarmState.AutoFarmComputers and scriptRunning do
        task.wait(0.02)
        if os.clock() - t0 > totalTime + 0.6 then
            done = true
            if conn then conn:Disconnect() end
            break
        end
    end
    if conn then conn:Disconnect() end

    if HRP and HRP.Parent then
        HRP.CFrame = CFrame.new(targetPos)
        HRP.AssemblyLinearVelocity = Vector3.zero
        HRP.AssemblyAngularVelocity = Vector3.zero
    end

    for _, part in ipairs(colliders) do
        if part and part.Parent then
            part.CanCollide = true
        end
    end
end

