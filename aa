        keyBtn.MouseButton1Click:Connect(function()
            if listening then return end
            listening = true; KeybindListening = true; keyBtn.Text = "pressione..."; keyBtn.TextColor3 = theme.Accent
            if keyStroke then play(keyStroke, EASE, {Color = theme.Accent, Transparency = 0.1}) end
