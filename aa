        if not GameStatus then
            GameStatus = RPS:FindFirstChild("GameStatus")
        end
        if GameStatus then
            s = tostring(GameStatus.Value or "")
        end
    end)
    if s == "" or s == "nil" then
        pcall(function()
            local sg = LP:FindFirstChild("PlayerGui")
            local ui = sg and sg:FindFirstChild("ScreenGui")
            local gif = ui and ui:FindFirstChild("GameInfoFrame")
            local box = gif and gif:FindFirstChild("GameStatusBox")
            if box and (box:IsA("TextLabel") or box:IsA("TextBox")) then
                s = tostring(box.Text or "")
            end
        end)
    end
    if s == "" or s == "nil" then
        pcall(function()
            local sg = LP:FindFirstChild("PlayerGui")
            local ui = sg and sg:FindFirstChild("ScreenGui")
            if not ui then return end
            for _, d in ipairs(ui:GetDescendants()) do
                if d:IsA("TextLabel") then
                    local t = string.upper(tostring(d.Text or ""))
                    if string.find(t, "COMPUTERS LEFT", 1, true)
                        or string.find(t, "HEAD START", 1, true)
                        or string.find(t, "FIND A EXIT", 1, true)
                        or string.find(t, "INTERMISSION", 1, true)
                        or string.find(t, "GAME OVER", 1, true) then
                        s = d.Text
                        break
                    end
                end
            end
        end)
    end
    return string.upper(tostring(s or ""))
end

